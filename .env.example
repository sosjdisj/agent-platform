# 复制为 .env 后按需修改：cp .env.example .env

# ===== 应用 =====
APP_NAME=Agent Platform
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_platform
# SQLAlchemy 异步连接串（docker compose 内可将 localhost 替换为 postgres）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_platform

# ===== Redis =====
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ===== Qdrant =====
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ===== RAG 向量化（参数全部来自配置，代码禁止硬编码） =====
# EMBEDDING_MODEL：魔搭社区模型 ID（首次运行自动下载到本地缓存）
# EMBEDDING_DIMENSION：向量维度，须等于模型输出维度或其 Matryoshka 截断值
#   （embeddinggemma-300m 原生 768，可截断 512 / 256 / 128）；修改后重新入库自动重建 Collection
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
QDRANT_COLLECTION_NAME=knowledge_chunks
CHUNK_MAX_CHARS=500

# ===== RAG 重排（CrossEncoder 粗召回 → 重排 → 阈值过滤） =====
# RERANKER_MODEL：魔搭社区模型 ID（首次运行自动下载到本地缓存）
# RERANK_RECALL_TOP_K：向量粗召回条数（重排候选池）
# RERANK_FINAL_TOP_K：重排后返回条数
# RERANK_SCORE_THRESHOLD：相关性阈值（Sigmoid 概率分 [0,1]），全部候选低于阈值时返回 NO_RELEVANT_DOCUMENT
#   默认 0.01 为本库语料实测校准值（无关 top1 ≤ 0.0031 / 强相关 top1 ≥ 0.7），语料变更后建议重新校准
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_RECALL_TOP_K=15
RERANK_FINAL_TOP_K=5
RERANK_SCORE_THRESHOLD=0.01

# ===== RAG 查询改写（首搜未命中 → LLM 改写口语化查询 → 重搜） =====
# QUERY_REWRITE_MAX_TIMES：全程最多改写重搜次数，仍无命中则返回 NO_RELEVANT_DOCUMENT
QUERY_REWRITE_MAX_TIMES=2

# ===== LLM（OpenAI 兼容 API；全项目唯一 Client 见 backend/app/core/llm.py） =====
# LLM_BASE_URL：任意 OpenAI 兼容服务地址（如 DeepSeek / 通义兼容模式 / vLLM 等，需含 /v1）
# LLM_API_KEY：对应服务的 API Key（生产环境必须配置）
# LLM_MODEL：对话 / 工具调用 / 结构化输出统一使用的模型 ID
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ===== Agent 编排（LangGraph：LLM ↔ Tool 循环） =====
# AGENT_MAX_ROUNDS：单次任务最多 LLM 决策轮次，超限截断为 failed
AGENT_MAX_ROUNDS=5
# SUPERVISOR_MAX_ROUNDS：Supervisor 单任务最多调度的专业 Agent 数，超限强制汇总
SUPERVISOR_MAX_ROUNDS=3

# ===== 健康检查 =====
HEALTHCHECK_TIMEOUT=3

# ===== 知识文档目录（相对项目根；seed 落盘知识文档，后续 RAG / 向量化读取） =====
KNOWLEDGE_DOCS_DIR=data/knowledge_docs

# ===== CORS（逗号分隔的允许来源，前端 axios 开启 withCredentials 时必须为显式来源） =====
CORS_ORIGINS=http://localhost:5173

# ===== 认证 Cookie（HttpOnly；禁止 URL 传 token） =====
# SSE_COOKIE_NAME：SSE 认证（承载当前 access token，供 EventSource 使用）
# REFRESH_COOKIE_NAME：长效刷新令牌（浏览器 JS 不可读，/refresh 与 /logout 从 Cookie 读取）
SSE_COOKIE_NAME=sse_token
REFRESH_COOKIE_NAME=refresh_token
# lax / strict / none（none 需配合 COOKIE_SECURE=true）
COOKIE_SAMESITE=lax
# 留空 = 仅当前 host；跨子域部署（api.example.com ↔ app.example.com）时填 .example.com
COOKIE_DOMAIN=
# 生产环境（HTTPS）必须开启
COOKIE_SECURE=false

# ===== 安全头与前端托管 =====
# HTTPS 部署时开启，附加 Strict-Transport-Security（HSTS）响应头
ENABLE_HSTS=false
# 前端构建产物目录（相对项目根）：目录存在时由后端托管 SPA（含安全头 / GZip / 静态缓存）
FRONTEND_DIST_DIR=frontend/dist

# ===== SSE 实时推送 =====
# SSE_HEARTBEAT_SECONDS：事件流无数据空档期的心跳间隔（秒），须低于代理空闲超时
SSE_HEARTBEAT_SECONDS=15
